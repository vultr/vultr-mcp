{
    "name": "vultr/mcp-server",
    "description": "PHP MCP (Model Context Protocol) server for the Vultr cloud platform",
    "type": "project",
    "license": "MIT",
    "keywords": ["vultr", "mcp", "model-context-protocol", "cloud", "php"],
    "require": {
        "php": ">=8.2",
        "mcp/sdk": "^0.5",
        "guzzlehttp/guzzle": "^7.8",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "symfony/console": "^7.2",
        "symfony/runtime": "^7.2",
        "runtime/frankenphp-symfony": "^0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Vultr\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vultr\\Mcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "VULTR_MCP_TRANSPORT=http frankenphp php-server --worker=public/index.php",
        "serve:stdio": "php bin/console mcp:stdio",
        "generate": "php bin/console mcp:generate",
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse src --level=6"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    },
    "minimum-stability": "stable"
}
