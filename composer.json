{
    "name": "vultr/mcp-server",
    "description": "PHP MCP (Model Context Protocol) server for the Vultr cloud platform",
    "type": "project",
    "license": "MIT",
    "keywords": ["vultr", "mcp", "model-context-protocol", "cloud", "php"],
    "require": {
        "php": ">=8.1",
        "mcp/sdk": "^0.5",
        "guzzlehttp/guzzle": "^7.8",
        "vlucas/phpdotenv": "^5.6",
        "nyholm/psr7": "^1.8",
        "nyholm/psr7-server": "^1.1",
        "laminas/laminas-httphandlerrunner": "^2.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Vultr\\Mcp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Vultr\\Mcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "serve": "VULTR_MCP_TRANSPORT=http php -S ${SERVER_HOST:-0.0.0.0}:${SERVER_PORT:-8000} src/Server.php",
        "serve:stdio": "php src/Server.php",
        "generate": "php bin/generate.php",
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse src --level=6"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable"
}
