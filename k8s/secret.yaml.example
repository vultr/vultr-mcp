# Template: copy to k8s/secret.yaml (gitignored), fill in, then kubectl apply.
apiVersion: v1
kind: Secret
metadata:
  name: vultr-mcp-secrets
  labels:
    app: vultr-mcp
type: Opaque
stringData:
  # The Vultr OAuth client secret, used upstream only; MCP clients never see it.
  VULTR_OAUTH_CLIENT_SECRET: ""

  # Optional, for STDIO use; not needed with OAuth.
  VULTR_API_KEY: ""
