# TEMPLATE — do not put real values here. Copy to k8s/secret.yaml (gitignored),
# fill in, then kubectl apply.
apiVersion: v1
kind: Secret
metadata:
  name: vultr-mcp-secrets
  labels:
    app: vultr-mcp
type: Opaque
stringData:
  # Secret of the approved Vultr OAuth client app. Held server-side only —
  # OAuthProxy uses it upstream; MCP clients never see it (that's the point).
  VULTR_OAUTH_CLIENT_SECRET: ""

  # Optional fallback credential for non-OAuth / legacy use. Not needed when
  # OIDC is enabled (each user authorizes via OAuth).
  VULTR_API_KEY: ""
