# ============================================================
# Vultr MCP Server — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ------------------------------------------------------------
# Transport mode
# ------------------------------------------------------------
# Controls how the MCP server communicates with clients.
#
# "stdio" — Local mode. Reads JSON-RPC from STDIN, writes to STDOUT.
#            Used by Claude Desktop, VS Code, Cursor, and other MCP clients
#            that spawn this server as a child process.
#            Auth is not needed (local pipe, no network).
#            API key comes from VULTR_API_KEY env var.
#
# "http"   — Remote / hosted mode. Streamable HTTP + SSE endpoint.
#            Used for public hosting (e.g. mcp.vultr.com).
#            Requires auth (MCP_AUTH_TOKEN or per-user API keys).
#            API key comes from X-Vultr-API-Key header per request.
#
# If unset, the server auto-detects: STDIO when launched by an MCP client
# (stdin is a pipe), HTTP when run interactively (stdin is a TTY).
VULTR_MCP_TRANSPORT=

# ------------------------------------------------------------
# Vultr API key mode
# ------------------------------------------------------------
# When VULTR_PER_USER_MODE=true, each MCP client must provide
# their own Vultr API key via the X-Vultr-API-Key header (HTTP mode)
# or VULTR_API_KEY env var (STDIO mode).
# This is the recommended mode for public/hosted deployments
# where each user operates on their own Vultr account.
#
# When false (legacy mode), the server uses a single global
# VULTR_API_KEY for all requests.
VULTR_PER_USER_MODE=true

# ------------------------------------------------------------
# Vultr API credentials (REQUIRED in legacy mode)
# ------------------------------------------------------------
# Your Vultr personal access token.
# Generate one at: https://my.vultr.com/settings/#settingsapi
# Not required when VULTR_PER_USER_MODE=true (users provide their own).
VULTR_API_KEY=

# ------------------------------------------------------------
# MCP client authentication (HTTP mode only)
# ------------------------------------------------------------
# Bearer token that MCP clients must send in the Authorization header.
# Leave empty to disable authentication (development only).
#
# When VULTR_PER_USER_MODE=true and MCP_AUTH_TOKEN is empty,
# the X-Vultr-API-Key is validated as the sole auth layer.
#
# For production, replace static token validation with JWT verification
# from a proper OAuth 2.0 / PKCE provider (see src/Auth/VultrAuth.php).
MCP_AUTH_TOKEN=

# ------------------------------------------------------------
# Server configuration (HTTP mode only)
# ------------------------------------------------------------
# PHP built-in server binds to this address when running `composer serve`.
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# Set to false ONLY for local development when behind a proxy that intercepts TLS.
# Never disable SSL verification in production.
SSL_VERIFY=true

# Override the Vultr API base URL (useful for local/staging environments).
# Defaults to https://api.vultr.com/v2/ when unset.
# VULTR_API_BASE_URL=https://api.vultr.com/v2/
